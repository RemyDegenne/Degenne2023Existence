module

public import Degenne2023Existence.D2023.Setting
public import Degenne2023Existence.ForLMLExplore.Bandits.StaticAllocation

/-!
# Theorem 12 of [D23]: the large deviation principle under static proportions

Under a static proportions algorithm with proportions `w ∈ Δ_K^0`, at a model `μ` whose arms are in
one-parameter exponential families, the vector `μ̂_T` of the empirical means satisfies the large
deviation principle with speed `T` and good rate function `λ ↦ ∑ a, w a KL(λ_a, μ_a)`. The large
deviation principle (`LMLExplore.IsLDP`) is stated with the bounds for every set `S`, the
consequence that the paper draws from it.

The proof specializes `LMLExplore.Bandits.isLDP_empMean_rateFunction_of_abs_pullCount_sub_le`,
the principle for any laws of the arms whose cumulant generating function is finite near `0` and
any algorithms whose numbers of pulls stay within a fixed distance of `T w`: the members of an
exponential family at the means of the family have that property, and their Cramér rate functions
are the extended divergences `Measure.expFamilyRate`. The recommendation rule plays no role.

## Main statements

* `Degenne2023Existence.isLDP_empMean_of_isStaticProportions`: [D23, Theorem 12].

## References

* [D23] R. Degenne, *On the existence of a complexity in fixed budget bandit identification*,
  COLT 2023, arXiv:2303.09468v2.
-/

@[expose] public section

open MeasureTheory Learning LMLExplore LMLExplore.Identification

open scoped ENNReal

namespace Degenne2023Existence

variable {α ℐ : Type*} [Fintype α] [DecidableEq α] {mα : MeasurableSpace α}
  [MeasurableSingletonClass α] {mℐ : MeasurableSpace ℐ}
  {task : IdentTask α (α → ℝ) ℐ ℝ} {ρ : α → Measure ℝ}

/-- **The large deviation principle of the empirical means under static proportions**
[D23, Theorem 12]. Let the arm `a` belong to the exponential family generated by `ρ a` with the
statistic `id`, let `𝒜` be a static proportions algorithm with proportions `w` (and any
recommendation rule), and let `μ` be an admissible model whose means are means of the families.
Then the laws of the vectors `μ̂_T` of the empirical means after `T` rounds of `𝒜 T` satisfy the
large deviation principle with speed `T` and good rate function `λ ↦ ∑ a, w a KL(λ_a, μ_a)`, with
`KL(·, μ_a)` extended to every level by the Cramér rate function (`Measure.expFamilyRate`). -/
theorem isLDP_empMean_of_isStaticProportions
    (hν : ∀ μ a, μ a ∈ (ρ a).expFamilyMeans id →
      task.ν μ a = (ρ a).expFamily id ((ρ a).natParam id (μ a)))
    {rec : (α → ℝ) → ℐ} {𝒜 : ℕ → IdentAlg Unit α ℝ ℐ} {w : α → ℝ}
    (h𝒜 : task.IsStaticProportions rec 𝒜 w) {μ : α → ℝ} (hμ : μ ∈ task.M)
    (hμρ : ∀ a, μ a ∈ (ρ a).expFamilyMeans id) :
    IsLDP (fun T ↦ (trajMeasure (𝒜 T).alg (Environment.bandit (task.ν μ))).map
        fun h a ↦ empMean IT.action IT.feedback a T h)
        (fun x ↦ ∑ a, ENNReal.ofReal (w a) * (ρ a).expFamilyRate id (x a) (μ a)) ∧
      IsGoodRateFunction (fun x : α → ℝ ↦ ∑ a, ENNReal.ofReal (w a) *
        (ρ a).expFamilyRate id (x a) (μ a)) := by
  have hrate : (fun x : α → ℝ ↦ ∑ a, ENNReal.ofReal (w a) * (ρ a).expFamilyRate id (x a) (μ a)) =
      fun x ↦ ∑ a, ENNReal.ofReal (w a) * rateFunction id (task.ν μ a) (x a) := by
    ext x
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [Measure.expFamilyRate_def, hν μ a (hμρ a)]
  rw [hrate]
  have := task.isMarkovKernel_ν μ
  refine Bandits.isLDP_empMean_rateFunction_of_abs_pullCount_sub_le (fun a ↦ ?_) h𝒜.1
    (Fintype.card α) fun T ↦ (h𝒜.2.2 T).2.1 μ hμ
  rw [hν μ a (hμρ a)]
  exact Measure.zero_mem_interior_integrableExpSet_expFamily
    (Measure.natParam_mem_interior_integrableExpSet (hμρ a))

end Degenne2023Existence
