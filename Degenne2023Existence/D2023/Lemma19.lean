module

public import Degenne2023Existence.D2023.Setting

/-!
# Lemma 19 of [D23]: the static-proportions difficulty of two-armed best arm identification

For best arm identification with two arms in the same one-parameter exponential family, with
log-partition function `φ` and natural parameters `ξ₀`, `ξ₁` of the means `μ₀ ≠ μ₁`, the
static-proportions difficulty is `H^{sp}(μ)⁻¹ = KL(x*, μ₀)` at the mean
`x* = (φ(ξ₀) - φ(ξ₁)) / (ξ₀ - ξ₁)`. For every allocation `w`, the infimum over the alternatives of
`w₀ KL(λ₀, μ₀) + w₁ KL(λ₁, μ₁)` is its value at `λ₀ = λ₁ = x(w) = φ'(w₀ ξ₀ + w₁ ξ₁)`, and the
maximum over the allocations is attained at `w*` with `w*₀ = (φ'⁻¹(x*) - ξ₁) / (ξ₀ - ξ₁)`.

Here the arms are `0` and `1` (the paper's `1` and `2`), `φ = cgf id ρ` is the log-partition
function of the family generated by `ρ`, `φ'⁻¹` is `ρ.natParam id` and `KL(x, μ)` is
`ρ.expFamilyDiv id x μ`.

## Main statements

* `Degenne2023Existence.inv_staticDifficulty_baiTask_expFamily_two`: [D23, Lemma 19].
* `Degenne2023Existence.iInf_cost_baiTask_expFamily_two`,
  `Degenne2023Existence.isMaxOn_iInf_cost_baiTask_expFamily_two`: [D23, Lemma 19], the
  minimizers and the maximizer.

## References

* [D23] R. Degenne, *On the existence of a complexity in fixed budget bandit identification*,
  COLT 2023, arXiv:2303.09468v2.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory LMLExplore LMLExplore.Identification

open scoped ENNReal

namespace Degenne2023Existence

variable (ν : (Fin 2 → ℝ) → Kernel (Fin 2) ℝ) [∀ μ, IsMarkovKernel (ν μ)] {ρ : Measure ℝ}
  {μ : Fin 2 → ℝ} {ξ₀ ξ₁ : ℝ}

/-- **The static-proportions difficulty of two-armed best arm identification** [D23, Lemma 19].
For two arms in the exponential family generated by `ρ` with the statistic `id`, not almost
everywhere constant, best arm identification on the vectors of means of the family, and a vector
of means `μ` with `μ 0 ≠ μ 1` and natural parameters `ξ₀`, `ξ₁`,
`H^{sp}(μ)⁻¹ = KL(x*, μ 0)` with `x* = (φ(ξ₀) - φ(ξ₁)) / (ξ₀ - ξ₁)` and `φ` the log-partition
function. -/
theorem inv_staticDifficulty_baiTask_expFamily_two (hρ : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans id → ν μ a = ρ.expFamily id (ρ.natParam id (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans id) (hμ01 : μ 0 ≠ μ 1) (hξ₀ : ξ₀ = ρ.natParam id (μ 0))
    (hξ₁ : ξ₁ = ρ.natParam id (μ 1)) :
    (((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).staticDifficulty μ)⁻¹ =
      ENNReal.ofReal
        (ρ.expFamilyDiv id ((cgf id ρ ξ₀ - cgf id ρ ξ₁) / (ξ₀ - ξ₁)) (μ 0)) := by
  sorry

/-- **The minimizers of the cost of the alternatives** [D23, Lemma 19]. In the setting of
`inv_staticDifficulty_baiTask_expFamily_two`, for every allocation `w` of the simplex, the
infimum over the alternatives `λ` to `μ` of `w 0 KL(λ 0, μ 0) + w 1 KL(λ 1, μ 1)` is the value at
`λ 0 = λ 1 = x(w)`, with `x(w) = φ'(w 0 ξ₀ + w 1 ξ₁)`. -/
theorem iInf_cost_baiTask_expFamily_two (hρ : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans id → ν μ a = ρ.expFamily id (ρ.natParam id (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans id) (hμ01 : μ 0 ≠ μ 1) (hξ₀ : ξ₀ = ρ.natParam id (μ 0))
    (hξ₁ : ξ₁ = ρ.natParam id (μ 1)) {w : Fin 2 → ℝ} (hw : w ∈ simplex (Fin 2)) :
    ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).alternatives μ,
        ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).cost w μ' μ =
      ENNReal.ofReal
        (w 0 * ρ.expFamilyDiv id (deriv (cgf id ρ) (w 0 * ξ₀ + w 1 * ξ₁)) (μ 0) +
          w 1 * ρ.expFamilyDiv id (deriv (cgf id ρ) (w 0 * ξ₀ + w 1 * ξ₁)) (μ 1)) := by
  sorry

/-- **The optimal static proportions** [D23, Lemma 19]. In the setting of
`inv_staticDifficulty_baiTask_expFamily_two`, with `x* = (φ(ξ₀) - φ(ξ₁)) / (ξ₀ - ξ₁)`, the cost of
the alternatives `w ↦ inf_{λ ∈ Alt(μ)} ∑ a, w a KL(λ a, μ a)` is maximal on the simplex at `w*`
with `w* 0 = (φ'⁻¹(x*) - ξ₁) / (ξ₀ - ξ₁)` and `w* 1 = 1 - w* 0`. -/
theorem isMaxOn_iInf_cost_baiTask_expFamily_two (hρ : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans id → ν μ a = ρ.expFamily id (ρ.natParam id (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans id) (hμ01 : μ 0 ≠ μ 1) (hξ₀ : ξ₀ = ρ.natParam id (μ 0))
    (hξ₁ : ξ₁ = ρ.natParam id (μ 1)) {w₀ : ℝ}
    (hw₀ : w₀ = (ρ.natParam id ((cgf id ρ ξ₀ - cgf id ρ ξ₁) / (ξ₀ - ξ₁)) - ξ₁) / (ξ₀ - ξ₁)) :
    IsMaxOn (fun w ↦
        ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).alternatives μ,
          ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).cost w μ' μ)
      (simplex (Fin 2)) ![w₀, 1 - w₀] := by
  sorry

end Degenne2023Existence
