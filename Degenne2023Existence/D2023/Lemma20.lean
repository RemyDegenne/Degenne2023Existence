module

public import Degenne2023Existence.D2023.Setting
public import Degenne2023Existence.ForLMLExplore.Identification.Task.BestArmTwo
public import LMLExplore.Probability.Distributions.ExponentialFamily.Gaussian

/-!
# Lemma 20 of [D23]: the static-proportions difficulty of two sub-Gaussian arms

For best arm identification with two arms in the same one-parameter exponential family, whose
members of means `μ₀` and `μ₁` are `σ²`-sub-Gaussian, with natural parameters `ξ₀` and `ξ₁`,
`H^{sp}(μ)⁻¹ ≥ max (KL(μ₀, μ₁)², KL(μ₁, μ₀)²) / (2 σ² (ξ₀ - ξ₁)²)`. For Gaussian arms with a common
variance `σ²` this is an equality, and the two terms of the maximum are equal.

## Main statements

* `Degenne2023Existence.ofReal_div_le_inv_staticDifficulty_baiTask_two`: [D23, Lemma 20].
* `Degenne2023Existence.inv_staticDifficulty_baiTask_gaussian_two`: [D23, Lemma 20], the
  Gaussian case.

## References

* [D23] R. Degenne, *On the existence of a complexity in fixed budget bandit identification*,
  COLT 2023, arXiv:2303.09468v2.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory LMLExplore.Identification

open scoped ENNReal NNReal

namespace Degenne2023Existence

variable (ν : (Fin 2 → ℝ) → Kernel (Fin 2) ℝ) [∀ μ, IsMarkovKernel (ν μ)] {ρ : Measure ℝ}
  {μ : Fin 2 → ℝ} {ξ₀ ξ₁ : ℝ}

/-- **Lower bound for two sub-Gaussian arms** [D23, Lemma 20]. For two arms in the exponential
family generated by `ρ` with the statistic `id`, not almost everywhere constant, best arm
identification on the vectors of means of the family, and a vector of means `μ` with `μ 0 ≠ μ 1`,
natural parameters `ξ₀`, `ξ₁` and `σ²`-sub-Gaussian members,
`max (KL(μ 0, μ 1)², KL(μ 1, μ 0)²) / (2 σ² (ξ₀ - ξ₁)²) ≤ H^{sp}(μ)⁻¹`. -/
theorem ofReal_div_le_inv_staticDifficulty_baiTask_two (hρ : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans id → ν μ a = ρ.expFamily id (ρ.natParam id (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans id) (hμ01 : μ 0 ≠ μ 1) (hξ₀ : ξ₀ = ρ.natParam id (μ 0))
    (hξ₁ : ξ₁ = ρ.natParam id (μ 1)) {σ2 : ℝ≥0}
    (hsub : ∀ a, HasSubgaussianMGF (fun x ↦ x - μ a) σ2 (ρ.expFamily id (ρ.natParam id (μ a)))) :
    ENNReal.ofReal (max (ρ.expFamilyDiv id (μ 0) (μ 1) ^ 2) (ρ.expFamilyDiv id (μ 1) (μ 0) ^ 2) /
        (2 * σ2 * (ξ₀ - ξ₁) ^ 2)) ≤
      (((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans id}).staticDifficulty μ)⁻¹ := by
  subst hξ₀ hξ₁
  exact LMLExplore.Identification.ofReal_div_le_inv_staticDifficulty_baiTask_two ν hρ hν hμ hμ01
    hsub

/-- **Two Gaussian arms** [D23, Lemma 20]. For two Gaussian arms with a common variance
`σ2 ≠ 0`, seen as the exponential family generated by `𝒩(m, σ2)` with the statistic `id`, and a
vector of means `μ` with `μ 0 ≠ μ 1` and natural parameters `ξ₀`, `ξ₁`,
`H^{sp}(μ)⁻¹ = KL(μ 0, μ 1)² / (2 σ² (ξ₀ - ξ₁)²)` and `KL(μ 0, μ 1) = KL(μ 1, μ 0)`. -/
theorem inv_staticDifficulty_baiTask_gaussian_two (m : ℝ) {σ2 : ℝ≥0} (hσ2 : σ2 ≠ 0)
    (hν : ∀ μ a, ν μ a = gaussianReal (μ a) σ2) (hμ01 : μ 0 ≠ μ 1)
    (hξ₀ : ξ₀ = (gaussianReal m σ2).natParam id (μ 0))
    (hξ₁ : ξ₁ = (gaussianReal m σ2).natParam id (μ 1)) :
    ((baiTask ν id).staticDifficulty μ)⁻¹ =
        ENNReal.ofReal ((gaussianReal m σ2).expFamilyDiv id (μ 0) (μ 1) ^ 2 /
          (2 * σ2 * (ξ₀ - ξ₁) ^ 2)) ∧
      (gaussianReal m σ2).expFamilyDiv id (μ 0) (μ 1) =
        (gaussianReal m σ2).expFamilyDiv id (μ 1) (μ 0) := by
  subst hξ₀ hξ₁
  have hT := LMLExplore.not_ae_eq_const_gaussianReal m hσ2
  have hμ (a : Fin 2) := LMLExplore.mem_expFamilyMeans_gaussianReal m hσ2 (μ a)
  have hη : (gaussianReal m σ2).natParam id (μ 0) ≠ (gaussianReal m σ2).natParam id (μ 1) :=
    (Measure.strictMonoOn_natParam hT).injOn.ne (hμ 0) (hμ 1) hμ01
  have h := inv_staticDifficulty_baiTask_two ν hT
    (fun μ a _ ↦ by rw [hν, LMLExplore.expFamily_natParam_gaussianReal m hσ2]) hμ hμ01
  rw [LMLExplore.setOf_forall_mem_expFamilyMeans_gaussianReal m hσ2, IdentTask.restrict_univ] at h
  refine ⟨h.trans (congrArg ENNReal.ofReal ?_), ?_⟩
  · rw [LMLExplore.expFamilyDiv_gaussianReal m hσ2 _ (μ 0), Measure.slope_cgf_natParam_eq_sub hη,
      sub_sub_cancel_left, neg_sq, div_pow, div_div, mul_comm (_ ^ 2)]
  · rw [LMLExplore.expFamilyDiv_gaussianReal m hσ2, LMLExplore.expFamilyDiv_gaussianReal m hσ2,
      sub_sq_comm]

end Degenne2023Existence
