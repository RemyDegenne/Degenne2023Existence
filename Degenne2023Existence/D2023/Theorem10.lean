namespace Degenne2023Existence

/-- **The oracle difficulty in Bernoulli best arm identification** [D23, proof of Theorem 10]. For
best arm identification on the Bernoulli bandits with means in `(0, 1)` and a class `𝒞` of
algorithm families containing the static proportions algorithms, at every model `μ` with a unique
best arm, `H_𝒞(μ) ≤ H_{𝒞^{sp}}(μ) ≤ H^{sp}(μ)`: the Bernoulli laws of means in `(0, 1)` are the
exponential family generated by `Ber(1 / 2)`, whose samples lie in `[0, 1]`, the closure of its
means, and the task satisfies Assumption 1 on `(0, 1)^K`. -/
lemma oracleDifficulty_le_staticDifficulty_baiTask_bernoulli {α : Type*} [Fintype α]
    [DecidableEq α] {mα : MeasurableSpace α} [MeasurableSingletonClass α]
    (𝒞 : Set (ℕ → IdentAlg Unit α ℝ α))
    (h𝒞 : ((baiTask (fun μ : α → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).staticClass ⊆ 𝒞) {μ : α → ℝ}
    (hμ : μ ∈ ((baiTask (fun μ : α → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).M) :
    ((baiTask (fun μ : α → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).oracleDifficulty 𝒞 μ ≤
      ((baiTask (fun μ : α → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).staticDifficulty μ := by
  set ρ := Ber((1 : ℝ), 0, unitInterval.sigmoid 0)
  have hmeans : ρ.expFamilyMeans id = Set.Ioo 0 1 := expFamilyMeans_bernoulliMeasure_sigmoid 0
  have hT : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c := not_ae_eq_const_bernoulliMeasure
    (by simp only [unitInterval.coe_sigmoid, Real.sigmoid_zero]; norm_num)
  have hS : {μ : α → ℝ | ∀ c, μ c ∈ Set.Ioo 0 1} = Set.univ.pi fun _ ↦ Set.Ioo 0 1 := by
    ext
    simp
  have hreg : IsRegular ((baiTask (fun μ : α → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict {μ | ∀ c, μ c ∈ Set.Ioo 0 1})
      {μ : α → ℝ | ∀ a, μ a ∈ ρ.expFamilyMeans id} := by
    have : Nonempty α := by
      have h := hμ
      rw [IdentTask.M_restrict, M_baiTask] at h
      exact ⟨h.1.choose⟩
    simp only [hmeans]
    exact isRegular_baiTask _ (hS ▸ isOpen_set_pi Set.finite_univ fun _ _ ↦ isOpen_Ioo)
      (hS ▸ convex_pi fun _ _ ↦ convex_Ioo 0 1)
  refine (IdentTask.oracleDifficulty_anti _ h𝒞 μ).trans ?_
  exact oracleDifficulty_staticClass_le (ρ := fun _ ↦ ρ) (fun _ ↦ hT)
    (fun _ ↦ by
      rw [hmeans, closure_Ioo zero_ne_one]
      simpa using ae_mem_uIcc_bernoulliMeasure (1 : ℝ) 0 (unitInterval.sigmoid 0))
    (fun μ a ha ↦ by
      rw [hmeans] at ha
      rw [IdentTask.ν_restrict, ν_baiTask, Bandits.bernoulliBandit_apply,
        expFamily_natParam_bernoulliMeasure_sigmoid 0 ha,
        Set.projIcc_of_mem _ (Set.Ioo_subset_Icc_self ha)])
    hreg ((isSingleAnswer_baiTask _ id).restrict _) hμ (Set.toFinite _).measurableSet

/-- **The first term of the bound** [D23, proof of Theorem 10]. For `x ∈ (0, 1 / 20]`, with `z₀` the
Chernoff point of the means `(x / 2, x)` (Lemma 9),
`klFun (4 / 5) ≤ d(z₀, x) / d(x (1 + x), x / 2)`: `0 < z₀ ≤ 4 x / 5`, so that
`d(z₀, x) ≥ x klFun (z₀ / x) ≥ x klFun (4 / 5)`, and `d(x (1 + x), x / 2) ≤ x`. -/
lemma ofReal_klFun_le_klBer_mul_inv_klBer {x : ℝ} (hx0 : 0 < x) (hx : x ≤ 1 / 20) :
    ENNReal.ofReal (klFun (4 / 5)) ≤
      klBer (Real.log ((1 - x) / (1 - x / 2)) / Real.log (x / 2 * (1 - x) / ((1 - x / 2) * x))) x *
        (klBer (x * (1 + x)) (x / 2))⁻¹ := by
  set u := (1 - x) / (1 - x / 2) with hu
  set z := Real.log u / Real.log (x / 2 * (1 - x) / ((1 - x / 2) * x)) with hz
  have h1x : 0 < 1 - x := by linarith
  have h2x : 0 < 1 - x / 2 := by linarith
  have hu0 : 0 < u := div_pos h1x h2x
  have hu1 : u < 1 := (div_lt_one h2x).2 (by linarith)
  have hv : x / 2 * (1 - x) / ((1 - x / 2) * x) = u / 2 := by
    rw [hu]
    field_simp
  have hlogu : Real.log u < 0 := Real.log_neg hu0 hu1
  have hlogv : Real.log (u / 2) = Real.log u - Real.log 2 :=
    Real.log_div hu0.ne' two_ne_zero
  have hlog2 := Real.log_two_gt_d9
  -- `-log u ≤ x / (2 (1 - x))`
  have hlogu' : -Real.log u ≤ x / 2 / (1 - x) := by
    have := Real.log_le_sub_one_of_pos (inv_pos.2 hu0)
    rw [Real.log_inv] at this
    refine this.trans_eq ?_
    rw [hu]
    field_simp
    ring
  -- the Chernoff point `z = -log u / (log 2 - log u)` is in `(0, 4 x / 5]`
  have hz_eq : z = (-Real.log u) / (Real.log 2 - Real.log u) := by
    rw [hz, hv, hlogv, ← neg_div_neg_eq, neg_sub]
  have hz0 : 0 < z := by
    rw [hz_eq]
    exact div_pos (by linarith) (by linarith)
  have hzx : z ≤ 4 / 5 * x := by
    rw [hz_eq, div_le_iff₀ (by linarith)]
    have h5 : x / 2 / (1 - x) ≤ 4 / 5 * x * Real.log 2 := by
      rw [div_le_iff₀ h1x]
      have : 1 / 2 < 4 / 5 * Real.log 2 * (1 - x) := by nlinarith
      nlinarith [mul_lt_mul_of_pos_left this hx0]
    nlinarith
  have hx1 : x ∈ Set.Ioo 0 1 := ⟨hx0, by linarith⟩
  have hzI : z ∈ Set.Icc 0 1 := ⟨hz0.le, by linarith⟩
  -- the numerator is at least `x klFun (4 / 5)`
  have hnum : ENNReal.ofReal (x * klFun (4 / 5)) ≤ klBer z x := by
    rw [klBer_eq_ofReal_klBerReal hzI (Set.Ioo_subset_Icc_self hx1) (klBer_ne_top hx1)]
    refine ENNReal.ofReal_le_ofReal ((mul_le_mul_of_nonneg_left ?_ hx0.le).trans
      (mul_klFun_div_le_klBerReal (by linarith) hx1))
    exact antitoneOn_klFun ⟨div_nonneg hz0.le hx0.le, (div_le_one hx0).2 (by linarith)⟩
      (by norm_num) ((div_le_iff₀ hx0).2 (by linarith))
  -- the denominator is at most `x`
  have hden : klBer (x * (1 + x)) (x / 2) ≤ ENNReal.ofReal x := by
    have hp : x * (1 + x) ∈ Set.Icc 0 1 := ⟨by positivity, by nlinarith⟩
    have hq : x / 2 ∈ Set.Ioo 0 1 := ⟨by positivity, by linarith⟩
    refine (klBer_le_ofReal_sq_sub_div hp hq).trans (ENNReal.ofReal_le_ofReal ?_)
    rw [div_le_iff₀ (mul_pos hq.1 (sub_pos.2 hq.2))]
    have h6 : (1 / 2 + x) ^ 2 ≤ 1 / 2 - x / 4 := by nlinarith
    have e1 : (x * (1 + x) - x / 2) ^ 2 = x ^ 2 * (1 / 2 + x) ^ 2 := by ring
    have e2 : x * (x / 2 * (1 - x / 2)) = x ^ 2 * (1 / 2 - x / 4) := by ring
    rw [e1, e2]
    exact mul_le_mul_of_nonneg_left h6 (sq_nonneg x)
  calc ENNReal.ofReal (klFun (4 / 5))
      = ENNReal.ofReal (x * klFun (4 / 5)) * (ENNReal.ofReal x)⁻¹ := by
        rw [ENNReal.ofReal_mul hx0.le, mul_comm (ENNReal.ofReal x), mul_assoc,
          ENNReal.mul_inv_cancel (ENNReal.ofReal_pos.2 hx0).ne' ENNReal.ofReal_ne_top, mul_one]
    _ ≤ klBer z x * (klBer (x * (1 + x)) (x / 2))⁻¹ := by gcongr

/-- **The second term of the bound** [D23, proof of Theorem 10]. With `z₁(x)` the Chernoff point of
the means `(x (1 + x), 1 / 2)` (Lemma 9), `d(z₁(x), 1 / 2) / d(x, 1 / 2) → 1` as `x → 0⁺`:
`z₁(x) → 0`, and both relative entropies tend to `d(0, 1 / 2) = log 2`. -/
lemma tendsto_klBer_mul_inv_klBer_half :
    Tendsto (fun x : ℝ ↦ klBer (Real.log ((1 - 1 / 2) / (1 - x * (1 + x))) /
        Real.log (x * (1 + x) * (1 - 1 / 2) / ((1 - x * (1 + x)) * (1 / 2)))) (1 / 2) *
      (klBer x (1 / 2))⁻¹) (𝓝[>] 0) (𝓝 1) := by
  have h12 : (1 / 2 : ℝ) ∈ Set.Ioo 0 1 := by norm_num
  -- `klBer · (1 / 2)` is continuous
  have hg : Continuous fun p : ℝ ↦ klBer p (1 / 2) := by
    have : (fun p : ℝ ↦ klBer p (1 / 2)) =
        fun p ↦ Function.uncurry klBer ((Set.projIcc 0 1 zero_le_one p : ℝ), 1 / 2) := by
      ext p
      rw [Function.uncurry_apply_pair, ← klBer_projIcc p (1 / 2),
        Set.projIcc_of_mem _ (Set.Ioo_subset_Icc_self h12)]
    rw [this]
    exact continuousOn_klBer.comp_continuous
      ((continuous_subtype_val.comp continuous_projIcc).prodMk continuous_const)
      fun p ↦ ⟨(Set.projIcc 0 1 zero_le_one p).2, h12⟩
  have h0 : klBer 0 (1 / 2) ≠ 0 := by
    rw [Ne, klBer_eq_zero_iff (by norm_num) (by norm_num)]
    norm_num
  have htop : klBer 0 (1 / 2) ≠ ∞ := klBer_ne_top h12
  -- the Chernoff point tends to `0`: its denominator tends to `-∞`
  have hz : Tendsto (fun x : ℝ ↦ Real.log ((1 - 1 / 2) / (1 - x * (1 + x))) /
      Real.log (x * (1 + x) * (1 - 1 / 2) / ((1 - x * (1 + x)) * (1 / 2)))) (𝓝[>] 0) (𝓝 0) := by
    refine Tendsto.div_atBot (a := Real.log ((1 - 1 / 2) / (1 - 0 * (1 + 0)))) ?_ ?_
    · have : ContinuousAt (fun x : ℝ ↦ Real.log ((1 - 1 / 2) / (1 - x * (1 + x)))) 0 := by
        fun_prop (disch := norm_num)
      exact this.tendsto.mono_left nhdsWithin_le_nhds
    · refine Real.tendsto_log_nhdsGT_zero.comp (tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩)
      · have : ContinuousAt (fun x : ℝ ↦
            x * (1 + x) * (1 - 1 / 2) / ((1 - x * (1 + x)) * (1 / 2))) 0 := by
          fun_prop (disch := norm_num)
        simpa using this.tendsto.mono_left nhdsWithin_le_nhds
      · filter_upwards [Ioo_mem_nhdsGT (by norm_num : (0 : ℝ) < 1 / 2)] with x hx
        have : 0 < 1 - x * (1 + x) := by nlinarith [hx.1, hx.2]
        change 0 < x * (1 + x) * (1 - 1 / 2) / ((1 - x * (1 + x)) * (1 / 2))
        exact div_pos (mul_pos (mul_pos hx.1 (by linarith [hx.1])) (by norm_num))
          (mul_pos this (by norm_num))
  have h1 := (hg.tendsto 0).comp hz
  have h2 := (hg.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Set.Ioi 0))
  have := ENNReal.Tendsto.div h1 (Or.inl h0) h2 (Or.inl htop)
  rw [ENNReal.div_self h0 htop] at this
  exact this

/-- **The bound exceeds `1`** [D23, proof of Theorem 10]. Some `x ∈ (0, 1 / 20]` satisfies
`1 < klFun (4 / 5) + d(z₁(x), 1 / 2) / d(x, 1 / 2)`, with `z₁(x)` the Chernoff point of the means
`(x (1 + x), 1 / 2)`: the second term tends to `1` as `x → 0⁺`, and `klFun (4 / 5) > 0`. -/
lemma exists_one_lt_ofReal_klFun_add :
    ∃ x : ℝ, 0 < x ∧ x ≤ 1 / 20 ∧ 1 < ENNReal.ofReal (klFun (4 / 5)) +
      klBer (Real.log ((1 - 1 / 2) / (1 - x * (1 + x))) /
        Real.log (x * (1 + x) * (1 - 1 / 2) / ((1 - x * (1 + x)) * (1 / 2)))) (1 / 2) *
      (klBer x (1 / 2))⁻¹ := by
  have hpos : 0 < klFun (4 / 5) := by
    refine (klFun_nonneg (by norm_num)).lt_of_ne fun h ↦ ?_
    have := (klFun_eq_zero_iff (by norm_num : (0 : ℝ) ≤ 4 / 5)).1 h.symm
    norm_num at this
  have h := tendsto_klBer_mul_inv_klBer_half.const_add (ENNReal.ofReal (klFun (4 / 5)))
  have hlt : (1 : ℝ≥0∞) < ENNReal.ofReal (klFun (4 / 5)) + 1 := by
    rw [add_comm]
    exact ENNReal.lt_add_right ENNReal.one_ne_top (ENNReal.ofReal_pos.2 hpos).ne'
  obtain ⟨x, hx, hx'⟩ := ((h.eventually (lt_mem_nhds hlt)).and
    (Ioc_mem_nhdsGT (by norm_num : (0 : ℝ) < 1 / 20))).exists
  exact ⟨x, hx'.1, hx'.2, hx⟩

/-- **No complexity in best arm identification with two Bernoulli arms** [D23, Theorem 10]. For
best arm identification on the Bernoulli bandits with two arms and means in `(0, 1)`, and a class
`𝒞` of algorithm families containing the static proportions algorithms, the infimum over the
fixed-budget algorithm families of the maximal difficulty ratio to the oracle difficulty of `𝒞` is
larger than `1`.

The proof applies Corollary 4 at `μ(x) = (x (1 + x), x)` with the alternatives `(x / 2, x)` and
`(x (1 + x), 1 / 2)`, for an `x ∈ (0, 1 / 20]` at which the bound exceeds `1`; it bounds the limit
of the bound as `x → 0` below by `1 + klFun (4 / 5)` instead of computing it (see the module
docstring). -/
theorem one_lt_iInf_maxRatio_baiTask_bernoulli_two
    (𝒞 : Set (ℕ → IdentAlg Unit (Fin 2) ℝ (Fin 2)))
    (h𝒞 : ((baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).staticClass ⊆ 𝒞) :
    1 < ⨅ (𝒜 : ℕ → IdentAlg Unit (Fin 2) ℝ (Fin 2)) (_ : IsFixedBudgetFamily 𝒜),
      ((baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        Set.projIcc 0 1 zero_le_one (μ c)) id).restrict {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).maxRatio
        (((baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
          Set.projIcc 0 1 zero_le_one (μ c)) id).restrict
            {μ | ∀ c, μ c ∈ Set.Ioo 0 1}).oracleDifficulty 𝒞) 𝒜 := by
  set task := (baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
    Set.projIcc 0 1 zero_le_one (μ c)) id).restrict {μ | ∀ c, μ c ∈ Set.Ioo 0 1} with htask
  obtain ⟨x, hx0, hx20, hx⟩ := exists_one_lt_ofReal_klFun_add
  -- The model `μ = (x (1 + x), x)` and the alternatives `λ 0 = (x / 2, x)` and
  -- `λ 1 = (x (1 + x), 1 / 2)`, whose best arm is `1`.
  set μ : Fin 2 → ℝ := ![x * (1 + x), x] with hμ_def
  set lam : Fin 2 → Fin 2 → ℝ := ![![x / 2, x], ![x * (1 + x), 1 / 2]] with hlam_def
  have hxx : x * (1 + x) ∈ Set.Ioo 0 1 := ⟨by positivity, by nlinarith⟩
  have hx1 : x ∈ Set.Ioo 0 1 := ⟨hx0, by linarith⟩
  have hx2 : x / 2 ∈ Set.Ioo 0 1 := ⟨by positivity, by linarith⟩
  have h12 : (1 / 2 : ℝ) ∈ Set.Ioo 0 1 := by norm_num
  have hμI (c : Fin 2) : μ c ∈ Set.Ioo 0 1 := by
    fin_cases c
    exacts [hxx, hx1]
  have hlamI (j c : Fin 2) : lam j c ∈ Set.Ioo 0 1 := by
    fin_cases j <;> fin_cases c
    exacts [hx2, hx1, hxx, h12]
  have hμ10 : μ 1 < μ 0 := by
    change x < x * (1 + x)
    nlinarith
  have hlam10 (j : Fin 2) : lam j 0 < lam j 1 := by
    fin_cases j
    · change x / 2 < x
      linarith
    · change x * (1 + x) < 1 / 2
      nlinarith
  have hμM : μ ∈ task.M := by
    rw [htask, IdentTask.M_restrict, M_baiTask]
    exact ⟨⟨0, fun b hb ↦ by fin_cases b; exacts [absurd rfl hb, hμ10]⟩, hμI⟩
  have hlamM (j : Fin 2) : lam j ∈ task.M := by
    rw [htask, IdentTask.M_restrict, M_baiTask]
    exact ⟨⟨1, fun b hb ↦ by fin_cases b; exacts [hlam10 j, absurd rfl hb]⟩, hlamI j⟩
  have hcorrect_μ : task.correct μ = {0} := by
    rw [htask, IdentTask.correct_restrict, correct_baiTask_eq_singleton_iff]
    intro b hb
    fin_cases b
    exacts [absurd rfl hb, hμ10]
  have hcorrect_lam (j : Fin 2) : task.correct (lam j) = {1} := by
    rw [htask, IdentTask.correct_restrict, correct_baiTask_eq_singleton_iff]
    intro b hb
    fin_cases b
    exacts [hlam10 j, absurd rfl hb]
  -- The static-proportions difficulties are positive and finite, by Lemma 9.
  have hL9 (θ : Fin 2 → ℝ) (hθ : ∀ c, θ c ∈ Set.Ioo 0 1) (hθ01 : θ 0 ≠ θ 1) :=
    inv_staticDifficulty_baiTask_bernoulli_two hθ hθ01 rfl
  have hH0 (θ : Fin 2 → ℝ) (hθ : ∀ c, θ c ∈ Set.Ioo 0 1) (hθ01 : θ 0 ≠ θ 1) :
      task.staticDifficulty θ ≠ 0 := by
    rw [← ENNReal.inv_ne_top, (hL9 θ hθ hθ01).1]
    exact klBer_ne_top (hθ 0)
  have hHtop (θ : Fin 2 → ℝ) (hθ : ∀ c, θ c ∈ Set.Ioo 0 1) (hθ01 : θ 0 ≠ θ 1) :
      task.staticDifficulty θ ≠ ∞ := by
    rw [← ENNReal.inv_ne_zero, (hL9 θ hθ hθ01).1]
    exact klBer_ne_zero_of_klBer_eq (Set.Ioo_subset_Icc_self (hθ 0))
      (Set.Ioo_subset_Icc_self (hθ 1)) hθ01 ((hL9 θ hθ hθ01).1.symm.trans (hL9 θ hθ hθ01).2)
  have hHC (θ : Fin 2 → ℝ) (hθ : θ ∈ task.M) :
      task.oracleDifficulty 𝒞 θ ≤ task.staticDifficulty θ :=
    oracleDifficulty_le_staticDifficulty_baiTask_bernoulli 𝒞 h𝒞 hθ
  have hKL (θ θ' : Fin 2 → ℝ) (j : Fin 2) :
      klDiv (task.ν θ j) (task.ν θ' j) = klBer (θ j) (θ' j) := by
    simp [htask, Bandits.bernoulliBandit_apply]
  refine hx.trans_le (le_iInf₂ fun 𝒜 h𝒜 ↦ ?_)
  -- If the probability of error at `μ` does not tend to `0`, the ratio at `μ` is infinite.
  by_cases hp : Tendsto (task.errorProb 𝒜 μ) atTop (𝓝 0)
  swap
  · have hfin : task.oracleDifficulty 𝒞 μ ≠ ∞ :=
      ne_top_of_le_ne_top (hHtop μ hμI hμ10.ne') (hHC μ hμM)
    refine le_trans le_top (le_of_eq ?_)
