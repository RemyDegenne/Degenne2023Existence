/-!
# The setting of [D23]

The paper studies fixed-budget identification tasks whose models are the vectors of means
`μ : α → ℝ` of `K = Fintype.card α` arms, each arm in a one-parameter canonical exponential
family. Here a task is an `LMLExplore.Identification.IdentTask` on the models `α → ℝ` with real
observations: its admissible models are the paper's set `𝒟`, its answer sets
`task.answerSet i` the paper's `𝒟_i`, and arm `a` of the model `μ` has law `task.ν μ a`. When the
arm `a` belongs to the exponential family generated by the measure `ρ a` with the statistic `id`,
the statements assume
`task.ν μ a = (ρ a).expFamily id ((ρ a).natParam id (μ a))` for the means `μ a` of the family, and
the vectors of means of the families are `Set.univ.pi fun a ↦ (ρ a).expFamilyMeans id`.

The general notions (algorithm families, probability of error, rates, oracle difficulties,
difficulty ratios, static proportions) are in
`Degenne2023Existence/ForLMLExplore/Identification/FixedBudgetComplexity.lean`, and the large
deviation principles in
`Degenne2023Existence/ForLMLExplore/Probability/LargeDeviations/Basic.lean`. This file states the
paper's standing assumption, and checks it for best arm identification, which the paper does
implicitly after the statement of Assumption 1.

## Main definitions

* `Degenne2023Existence.IsRegular task S`: Assumption 1 of [D23], for the set `S` of the
  vectors of means of the families.

## Main statements

* `Degenne2023Existence.isRegular_baiTask`: best arm identification on an open convex set of
  vectors of means satisfies Assumption 1.

## References

* [D23] R. Degenne, *On the existence of a complexity in fixed budget bandit identification*,
  COLT 2023, arXiv:2303.09468v2.
-/

@[expose] public section

open LMLExplore.Identification

namespace Degenne2023Existence

variable {α ℐ 𝓨 : Type*} {mα : MeasurableSpace α} {m𝓨 : MeasurableSpace 𝓨}

/-- **Assumption 1** of [D23], for a task on the vectors of means `μ : α → ℝ` and the set `S` of
the vectors of means of the exponential families of the arms. The admissible models are vectors
of means of the families and each have a correct answer, and for every answer `i` the set
`𝒟_i = task.answerSet i` of the admissible models for which `i` is correct is open and equal to the
interior of its closure. The closures of the `𝒟_i` cover `S`. -/
structure IsRegular (task : IdentTask α (α → ℝ) ℐ 𝓨) (S : Set (α → ℝ)) : Prop where
  /-- The admissible models are vectors of means of the families. -/
  M_subset : task.M ⊆ S
  /-- Every admissible model has a correct answer: `𝒟 = ⋃ i, 𝒟_i`. -/
  M_subset_iUnion : task.M ⊆ ⋃ i, task.answerSet i
  /-- Each `𝒟_i` is open. -/
  isOpen_answerSet (i : ℐ) : IsOpen (task.answerSet i)
  /-- Each `𝒟_i` is the interior of its closure. -/
  interior_closure_answerSet (i : ℐ) : interior (closure (task.answerSet i)) = task.answerSet i
  /-- The closures of the `𝒟_i` cover the vectors of means of the families. -/
  subset_iUnion_closure : S ⊆ ⋃ i, closure (task.answerSet i)

/-- **Assumption 1 for best arm identification.** For finitely many arms and an open convex set
`S` of vectors of means (all of `ℝ^K` for Gaussian arms, `(0, 1)^K` for Bernoulli arms), best arm
identification restricted to `S` satisfies Assumption 1 on `S`: its answer sets, the vectors of
`S` with a unique best arm `a`, are open and convex, hence the interiors of their closures, and
every vector of `S` is a limit of vectors of `S` whose unique best arm is one of its arms of
largest mean. -/
lemma isRegular_baiTask [Finite α] [Nonempty α] (ν : (α → ℝ) → ProbabilityTheory.Kernel α 𝓨)
    [∀ μ, ProbabilityTheory.IsMarkovKernel (ν μ)] {S : Set (α → ℝ)} (hS : IsOpen S)
    (hSc : Convex ℝ S) :
    IsRegular ((baiTask ν id).restrict S) S where
  M_subset := by
    rw [IdentTask.M_restrict]
    exact Set.inter_subset_right
  M_subset_iUnion := by
    rw [IdentTask.M_restrict, M_baiTask]
    rintro μ ⟨⟨a, ha⟩, hμS⟩
    refine Set.mem_iUnion.2 ⟨a, ?_⟩
    rw [IdentTask.answerSet_restrict]
    exact ⟨(mem_answerSet_baiTask_iff ν id).2 ha, hμS⟩
  isOpen_answerSet := isOpen_answerSet_baiTask_restrict ν hS
  interior_closure_answerSet := interior_closure_answerSet_baiTask_restrict ν hS hSc
  subset_iUnion_closure := subset_iUnion_closure_answerSet_baiTask_restrict ν hS

end Degenne2023Existence
