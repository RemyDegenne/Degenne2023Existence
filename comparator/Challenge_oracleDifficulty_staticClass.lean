-- ═══ Degenne2023Existence.ForLMLExplore.Identification.FixedBudgetComplexity ═══
@[expose] public section
open MeasureTheory Filter Topology Learning
open scoped ENNReal
namespace LMLExplore.Identification
variable {α Θ ℐ 𝓨 : Type*} {mα : MeasurableSpace α} {m𝓨 : MeasurableSpace 𝓨} [MeasurableSpace ℐ]
namespace IdentTask
variable (task : IdentTask α Θ ℐ 𝓨)

/-- The alternatives to the model `θ`: the admissible models that have no correct answer in common
with `θ`. For a single-answer task and an admissible model `θ` with answer `i`, they are the
alternatives `task.alt i` to `i`. -/
def alternatives (θ : Θ) : Set Θ :=
  {θ' | θ' ∈ task.M ∧ Disjoint (task.correct θ) (task.correct θ')}

/-- The probability of error `p_{θ,T}(𝒜)` of the family `𝒜` with budget `T` on the model `θ`: the
probability that the output of `𝒜 T` in the bandit of `θ` is not a correct answer of `θ`. -/
noncomputable def errorProb (𝒜 : ℕ → IdentAlg Unit α 𝓨 ℐ) (θ : Θ) (T : ℕ) : ℝ≥0∞ :=
  (𝒜 T).outputMeasure (Environment.bandit (task.ν θ)) (task.correct θ)ᶜ

/-- The rate `h_{θ,T}(𝒜) = T / log (1 / p_{θ,T}(𝒜))` of the family `𝒜` with budget `T` on the
model `θ`, so that `p_{θ,T}(𝒜) = exp (-T / h_{θ,T}(𝒜))`. It is `0` if `p_{θ,T}(𝒜) = 0` and `∞` if
`p_{θ,T}(𝒜) = 1` and `T > 0`. -/
noncomputable def errorRate (𝒜 : ℕ → IdentAlg Unit α 𝓨 ℐ) (θ : Θ) (T : ℕ) : ℝ≥0∞ :=
  T / (-ENNReal.log (task.errorProb 𝒜 θ T)).toENNReal

/-- The oracle difficulty `H_𝒞(θ) = inf_{𝒜 ∈ 𝒞} limsup_{T → ∞} h_{θ,T}(𝒜)` of the class `𝒞` of
algorithm families at the model `θ`: the asymptotic rate at `θ` of the family of the class that is
best at `θ`. -/
noncomputable def oracleDifficulty (𝒞 : Set (ℕ → IdentAlg Unit α 𝓨 ℐ)) (θ : Θ) : ℝ≥0∞ :=
  ⨅ 𝒜 ∈ 𝒞, limsup (task.errorRate 𝒜 θ) atTop

section StaticProportions
variable [Fintype α]

/-- The static-proportions difficulty
`H^{sp}(θ) = (max_{w ∈ Δ_K} inf_{λ ∈ Alt(θ)} ∑ a, w a KL(ν_a(λ), ν_a(θ)))⁻¹` of the model `θ`,
with the alternative first in the divergence. It is the oracle difficulty of the class of static
proportions algorithms for tasks with arms in exponential families [D23, Theorem 1]. -/
noncomputable def staticDifficulty (θ : Θ) : ℝ≥0∞ :=
  (⨆ w ∈ simplex α, ⨅ θ' ∈ task.alternatives θ, task.cost w θ' θ)⁻¹

variable [DecidableEq α] (task : IdentTask α (α → ℝ) ℐ ℝ)

/-- The family `𝒜` is a *static proportions* family with proportions `w` and recommendation rule
`rec`, for a task on the vectors of means `μ : α → ℝ` with real observations: the proportions are
positive and sum to `1`, and for every budget `T`, `𝒜 T` stops after `T` rounds, on every
admissible model its numbers of pulls satisfy `|N_{T,a} - T w a| ≤ K` almost surely, with `K` the
number of arms, and it recommends `rec μ̂_T` for the vector `μ̂_T` of the empirical means. -/
def IsStaticProportions (rec : (α → ℝ) → ℐ) (𝒜 : ℕ → IdentAlg Unit α ℝ ℐ) (w : α → ℝ) : Prop :=
  (∀ a, 0 < w a) ∧ ∑ a, w a = 1 ∧ ∀ T, IsFixedBudget (𝒜 T) T ∧
    (∀ μ ∈ task.M, ∀ᵐ h ∂(trajMeasure (𝒜 T).alg (Environment.bandit (task.ν μ))),
      ∀ a, |(pullCount IT.action a T h : ℝ) - T * w a| ≤ Fintype.card α) ∧
    ∀ h : Hist Unit α ℝ T, outputAt (𝒜 T) T h = Measure.dirac (rec (empMean' T h))

/-- The class `𝒞^{sp}` of static proportions families: the static proportions families with some
positive proportions and some recommendation rule that is correct on the admissible models. -/
def staticClass : Set (ℕ → IdentAlg Unit α ℝ ℐ) :=
  {𝒜 | ∃ rec : (α → ℝ) → ℐ, (∀ μ ∈ task.M, rec μ ∈ task.correct μ) ∧
    ∃ w, task.IsStaticProportions rec 𝒜 w}

variable {task}
end StaticProportions
end IdentTask
end LMLExplore.Identification
end

-- ═══ Degenne2023Existence.D2023.Setting ═══
@[expose] public section
open LMLExplore.Identification
namespace Degenne2023Existence
variable {α ℐ 𝓨 : Type*} {mα : MeasurableSpace α} {m𝓨 : MeasurableSpace 𝓨}

/-- **Assumption 1** of [D23], for a task on the vectors of means `μ : α → ℝ` and the set `S` of
the vectors of means of the exponential families of the arms. The admissible models are vectors
of means of the families and each have a correct answer, and for every answer `i` the set
`𝒟_i = task.answerSet i` of the admissible models for which `i` is correct is open and equal to the
interior of its closure. The closures of the `𝒟_i` cover `S`. -/
structure IsRegular (task : IdentTask α (α → ℝ) ℐ 𝓨) (S : Set (α → ℝ)) : Prop where
  /-- The admissible models are vectors of means of the families. -/
  M_subset : task.M ⊆ S
  /-- Every admissible model has a correct answer: `𝒟 = ⋃ i, 𝒟_i`. -/
  M_subset_iUnion : task.M ⊆ ⋃ i, task.answerSet i
  /-- Each `𝒟_i` is open. -/
  isOpen_answerSet (i : ℐ) : IsOpen (task.answerSet i)
  /-- Each `𝒟_i` is the interior of its closure. -/
  interior_closure_answerSet (i : ℐ) : interior (closure (task.answerSet i)) = task.answerSet i
  /-- The closures of the `𝒟_i` cover the vectors of means of the families. -/
  subset_iUnion_closure : S ⊆ ⋃ i, closure (task.answerSet i)

end Degenne2023Existence
end

-- ═══ Degenne2023Existence.D2023.Theorem1 ═══
@[expose] public section
open MeasureTheory Filter Topology Learning LMLExplore LMLExplore.Identification
open scoped ENNReal
namespace Degenne2023Existence
variable {α ℐ : Type*} [Fintype α] [DecidableEq α] {mα : MeasurableSpace α} [MeasurableSingletonClass α] [MeasurableSpace ℐ] [Finite ℐ] {task : IdentTask α (α → ℝ) ℐ ℝ} {ρ : α → Measure ℝ}

/-- **The oracle difficulty of static proportions algorithms** [D23, Theorem 1]. With answers with
measurable singletons, arms in exponential families as in
`tendsto_errorRate_of_isStaticProportions` and a task satisfying Assumption 1 with a single correct
answer on every admissible model, the oracle difficulty of the class of static proportions
algorithms at every admissible model `μ` is the static-proportions difficulty
`H^{sp}(μ) = (max_{w ∈ Δ_K} inf_{λ ∈ Alt(μ)} ∑ a, w a KL(ν_a(λ), ν_a(μ)))⁻¹`.

The paper writes the maximum over the positive proportions `Δ_K^0`; the maximum over the simplex
`Δ_K` has the same value. -/
theorem oracleDifficulty_staticClass [MeasurableSingletonClass ℐ]
    (hρ : ∀ a c, ¬ id =ᵐ[ρ a] fun _ ↦ c)
    (hρ_closure : ∀ a, ∀ᵐ x ∂(ρ a), x ∈ closure ((ρ a).expFamilyMeans id))
    (hν : ∀ μ a, μ a ∈ (ρ a).expFamilyMeans id →
      task.ν μ a = (ρ a).expFamily id ((ρ a).natParam id (μ a)))
    (hreg : IsRegular task {μ | ∀ a, μ a ∈ (ρ a).expFamilyMeans id})
    (hsingle : task.IsSingleAnswer) {μ : α → ℝ} (hμ : μ ∈ task.M) :
    task.oracleDifficulty task.staticClass μ = task.staticDifficulty μ := sorry

end Degenne2023Existence
